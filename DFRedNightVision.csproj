<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>DFRedNightVision</AssemblyName>
    <GameManagedDir Condition="'$(GameManagedDir)' == '' and '$(GameDir)' != ''">$(GameDir)/7DaysToDie_Data/Managed</GameManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameManagedDir)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <Reference Include="LogLibrary">
      <HintPath>$(GameManagedDir)/LogLibrary.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="ModInfo.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidateGameManagedDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(GameManagedDir)' == '' or !Exists('$(GameManagedDir)/Assembly-CSharp.dll')"
           Text="Set GameDir to your 7 Days to Die installation, or GameManagedDir to its managed assemblies directory." />
  </Target>

</Project>
